{
  "name": "@asf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "npm run build && node dist/database/migrate.js"
  },
  "dependencies": {
    "@asf/contracts": "0.1.0",
    "@fastify/cors": "11.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "postgres": "3.4.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}

