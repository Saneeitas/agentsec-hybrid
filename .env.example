# Server-only Supabase PostgreSQL connection string. Never prefix this with VITE_.
DATABASE_URL=postgresql://postgres.example:replace-me@db.example.supabase.co:5432/postgres
# Keep TLS certificate validation enabled for Supabase. Set false only for an explicitly local test database.
DATABASE_SSL=true

API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SCANNER_BASE_URL=http://scanner:8000
SCANNER_REQUEST_TIMEOUT_MS=3000
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=15000
WORKER_CONCURRENCY=2
SCAN_EXECUTION_TIMEOUT_MS=5000
SCAN_MAX_ATTEMPTS=3
SCAN_RETRY_DELAY_MS=500

# Generate distinct high-entropy values. The operator token is entered into the UI at runtime.
API_AUTH_TOKEN=replace-with-at-least-32-random-characters
SCANNER_SERVICE_TOKEN=replace-with-a-different-32-character-token

# This URL is intentionally public and contains no credentials.
VITE_API_BASE_URL=http://localhost:3000
