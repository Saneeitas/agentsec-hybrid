# Server-only Supabase PostgreSQL connection string. Never prefix this with VITE_.
DATABASE_URL=postgresql://postgres.example:replace-me@db.example.supabase.co:5432/postgres
# Keep TLS certificate validation enabled for Supabase. Set false only for an explicitly local test database.
DATABASE_SSL=true

API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SCANNER_BASE_URL=http://scanner:8000
SCANNER_REQUEST_TIMEOUT_MS=3000

# This URL is intentionally public and contains no credentials.
VITE_API_BASE_URL=http://localhost:3000

